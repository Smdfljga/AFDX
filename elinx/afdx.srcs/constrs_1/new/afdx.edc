# afdx.edc : top level clock and I/O constraints (Quartus SDC subset)
#
# Clocks
#   clk_50m    board 50 MHz oscillator, PLL input                         20.000 ns
#   clk_125m   PLL clk0 (x2.5): the MAC system clock clk_sys of both MACs,
#              i.e. the GMII side that has to stay at 125 MHz              8.000 ns
#   clk_25m    PLL clk1 (x0.5): everything else - the AFDX core, AND the
#              MAC client ports ff_tx_clk / ff_rx_clk of both MACs       40.000 ns
#   p0_rxc_a   PHY recovered receive clock, A net                          8.000 ns
#   p0_rxc_b   PHY recovered receive clock, B net                          8.000 ns
#
# GMII forces 125 MHz on the MAC system clock, but the MAC user side is an
# independent asynchronous client interface (one dcfifo plus a two stage reset
# synchronizer per direction, see eth_1.v).  Its ff_rx_* output is a pure
# combinational path out of the RX fifo RAM (measured 9.2 ns: 2.46 ns RAM read
# plus seven LUT levels), which cannot close in 8 ns, so ff_tx_clk / ff_rx_clk
# are driven from clk_25m.  The AFDX core is 25 MHz as well, and afdx_net_rx /
# afdx_tx_buf keep their per slot toggle handshake - at equal clocks it is still
# correct, just no longer a clock domain crossing at the top level.
#
# The cross clock false paths below are kept for the MAC internal asynchronous
# crossings (the IP only crosses through the dcfifo RAM and its own reset
# synchronizers); no top level path leaves clk_125m for clk_25m or the PHY
# recovered clocks any more.
#
# The board is not part of the deliverable: no pin assignments are given, so
# every I/O delay below is an assumed 2 ns PHY/board value.  I/O paths are a
# sanity check only; the interesting results are the register to register
# paths inside clk_125m and clk_25m.

create_clock -period 20.000 -name {clk_50m} -waveform {0.000 10.000} [get_ports {clk_50m}]
create_clock -period 8.000 -name {clk_125m} -waveform {0.000 4.000} [get_nets {\pll:u_pll|altpll:altpll_component|_clk0}]
# clk1 is the second altpll output and uses the same net naming as clk0 (_clk1).
# Unused altpll outputs are named pll~CLKx instead; if the P&R log ever reports
# that clk_25m has no source, check the clock list there and rebind this line.
create_clock -period 40.000 -name {clk_25m} -waveform {0.000 20.000} [get_nets {\pll:u_pll|altpll:altpll_component|_clk1}]
create_clock -period 8.000 -name {p0_rxc_a} -waveform {0.000 4.000} [get_ports {p0_rxc_a}]
create_clock -period 8.000 -name {p0_rxc_b} -waveform {0.000 4.000} [get_ports {p0_rxc_b}]

# clk_125m (MAC clk_sys / GMII side) <-> clk_25m (AFDX core + MAC client ports).
# No top level register to register path crosses these two clocks any more: the
# MAC crosses internally through its dcfifo RAM, and afdx_net_rx / afdx_tx_buf
# now have the same clock on both sides.  The paths are kept for the MAC
# internal asynchronous crossings (its own two stage reset synchronizers and the
# fifo handshakes), exactly like the PHY recovered clock boundaries below.
set_false_path -from [get_clocks {clk_125m}] -to [get_clocks {clk_25m}]
set_false_path -from [get_clocks {clk_25m}] -to [get_clocks {clk_125m}]

# The MAC client ports are on clk_25m now, and they only reach the PHY recovered
# clocks through the MAC's dcfifo, so cut those directions as well
set_false_path -from [get_clocks {clk_25m}] -to [get_clocks {p0_rxc_a}]
set_false_path -from [get_clocks {p0_rxc_a}] -to [get_clocks {clk_25m}]
set_false_path -from [get_clocks {clk_25m}] -to [get_clocks {p0_rxc_b}]
set_false_path -from [get_clocks {p0_rxc_b}] -to [get_clocks {clk_25m}]

# The PHY recovered clocks are asynchronous to the internal 125 MHz domain:
# each MAC crosses that boundary inside its own asynchronous FIFO.
set_false_path -from [get_clocks {clk_125m}] -to [get_clocks {p0_rxc_a}]
set_false_path -from [get_clocks {p0_rxc_a}] -to [get_clocks {clk_125m}]
set_false_path -from [get_clocks {clk_125m}] -to [get_clocks {p0_rxc_b}]
set_false_path -from [get_clocks {p0_rxc_b}] -to [get_clocks {clk_125m}]
set_false_path -from [get_clocks {p0_rxc_a}] -to [get_clocks {p0_rxc_b}]
set_false_path -from [get_clocks {p0_rxc_b}] -to [get_clocks {p0_rxc_a}]

# GMII receive, A net (PHY to FPGA, captured by p0_rxc_a)
set_input_delay -clock {p0_rxc_a} -max 2.000 [get_ports {p0_rxd_a[0] p0_rxd_a[1] p0_rxd_a[2] p0_rxd_a[3] p0_rxd_a[4] p0_rxd_a[5] p0_rxd_a[6] p0_rxd_a[7] p0_rxdv_a p0_rxer_a p0_col_a p0_crs_a}]
set_input_delay -clock {p0_rxc_a} -min 0.500 [get_ports {p0_rxd_a[0] p0_rxd_a[1] p0_rxd_a[2] p0_rxd_a[3] p0_rxd_a[4] p0_rxd_a[5] p0_rxd_a[6] p0_rxd_a[7] p0_rxdv_a p0_rxer_a p0_col_a p0_crs_a}]

# GMII receive, B net (PHY to FPGA, captured by p0_rxc_b)
set_input_delay -clock {p0_rxc_b} -max 2.000 [get_ports {p0_rxd_b[0] p0_rxd_b[1] p0_rxd_b[2] p0_rxd_b[3] p0_rxd_b[4] p0_rxd_b[5] p0_rxd_b[6] p0_rxd_b[7] p0_rxdv_b p0_rxer_b p0_col_b p0_crs_b}]
set_input_delay -clock {p0_rxc_b} -min 0.500 [get_ports {p0_rxd_b[0] p0_rxd_b[1] p0_rxd_b[2] p0_rxd_b[3] p0_rxd_b[4] p0_rxd_b[5] p0_rxd_b[6] p0_rxd_b[7] p0_rxdv_b p0_rxer_b p0_col_b p0_crs_b}]

# GMII transmit, A net (FPGA to PHY, launched from clk_125m)
set_output_delay -clock {clk_125m} -max 2.000 [get_ports {p0_txd_a[0] p0_txd_a[1] p0_txd_a[2] p0_txd_a[3] p0_txd_a[4] p0_txd_a[5] p0_txd_a[6] p0_txd_a[7] p0_txen_a p0_txer_a}]
set_output_delay -clock {clk_125m} -min 0.500 [get_ports {p0_txd_a[0] p0_txd_a[1] p0_txd_a[2] p0_txd_a[3] p0_txd_a[4] p0_txd_a[5] p0_txd_a[6] p0_txd_a[7] p0_txen_a p0_txer_a}]

# GMII transmit, B net (FPGA to PHY, launched from clk_125m)
set_output_delay -clock {clk_125m} -max 2.000 [get_ports {p0_txd_b[0] p0_txd_b[1] p0_txd_b[2] p0_txd_b[3] p0_txd_b[4] p0_txd_b[5] p0_txd_b[6] p0_txd_b[7] p0_txen_b p0_txer_b}]
set_output_delay -clock {clk_125m} -min 0.500 [get_ports {p0_txd_b[0] p0_txd_b[1] p0_txd_b[2] p0_txd_b[3] p0_txd_b[4] p0_txd_b[5] p0_txd_b[6] p0_txd_b[7] p0_txen_b p0_txer_b}]

# The GMII transmit clock inputs do not drive MAC logic in GMII mode
set_false_path -from [get_ports {p0_txc_a p0_txc_b}]

# Slow or static board side interfaces: MDC/MDIO management and PHY reset
set_false_path -from [get_ports {mdio_a mdio_b}]
set_false_path -to [get_ports {mdc_a mdc_b phy_rstb_a phy_rstb_b}]

# CPU side configuration and application interface: asynchronous slow access,
# the design keeps these as quasi static levels, so they are cut from timing
set_false_path -from [get_ports {cfg_wr_addr[0] cfg_wr_addr[1] cfg_wr_addr[2] cfg_wr_addr[3] cfg_wr_addr[4] cfg_wr_addr[5] cfg_wr_addr[6] cfg_wr_addr[7] cfg_wr_addr[8] cfg_wr_addr[9] cfg_wr_addr[10] cfg_wr_addr[11] cfg_wr_vlid[0] cfg_wr_vlid[1] cfg_wr_vlid[2] cfg_wr_vlid[3] cfg_wr_vlid[4] cfg_wr_vlid[5] cfg_wr_vlid[6] cfg_wr_vlid[7] cfg_wr_vlid[8] cfg_wr_vlid[9] cfg_wr_vlid[10] cfg_wr_vlid[11] cfg_wr_vlid[12] cfg_wr_vlid[13] cfg_wr_vlid[14] cfg_wr_vlid[15] cfg_wr_udp_port[0] cfg_wr_udp_port[1] cfg_wr_udp_port[2] cfg_wr_udp_port[3] cfg_wr_udp_port[4] cfg_wr_udp_port[5] cfg_wr_udp_port[6] cfg_wr_udp_port[7] cfg_wr_udp_port[8] cfg_wr_udp_port[9] cfg_wr_udp_port[10] cfg_wr_udp_port[11] cfg_wr_udp_port[12] cfg_wr_udp_port[13] cfg_wr_udp_port[14] cfg_wr_udp_port[15] cfg_wr_port_type[0] cfg_wr_port_type[1] cfg_wr_bag[0] cfg_wr_bag[1] cfg_wr_bag[2] cfg_wr_bag[3] cfg_wr_bag[4] cfg_wr_bag[5] cfg_wr_bag[6] cfg_wr_bag[7] cfg_wr_bag[8] cfg_wr_bag[9] cfg_wr_bag[10] cfg_wr_bag[11] cfg_wr_bag[12] cfg_wr_bag[13] cfg_wr_bag[14] cfg_wr_bag[15] cfg_wr_lmax[0] cfg_wr_lmax[1] cfg_wr_lmax[2] cfg_wr_lmax[3] cfg_wr_lmax[4] cfg_wr_lmax[5] cfg_wr_lmax[6] cfg_wr_lmax[7] cfg_wr_lmax[8] cfg_wr_lmax[9] cfg_wr_lmax[10] cfg_wr_lmax[11] cfg_wr_lmax[12] cfg_wr_lmax[13] cfg_wr_lmax[14] cfg_wr_lmax[15] cfg_wr_en cfg_wr_rm_en cfg_wr_ic_mode app_rd_vl_index[0] app_rd_vl_index[1] app_rd_vl_index[2] app_rd_vl_index[3] app_rd_byte_offset[0] app_rd_byte_offset[1] app_rd_byte_offset[2] app_rd_byte_offset[3] app_rd_byte_offset[4] app_rd_byte_offset[5] app_rd_byte_offset[6] app_rd_byte_offset[7] app_rd_byte_offset[8] app_rd_byte_offset[9] app_rd_byte_offset[10] app_rd_en app_wr_vl_index[0] app_wr_vl_index[1] app_wr_vl_index[2] app_wr_vl_index[3] app_wr_byte_offset[0] app_wr_byte_offset[1] app_wr_byte_offset[2] app_wr_byte_offset[3] app_wr_byte_offset[4] app_wr_byte_offset[5] app_wr_byte_offset[6] app_wr_byte_offset[7] app_wr_byte_offset[8] app_wr_byte_offset[9] app_wr_byte_offset[10] app_wr_data[0] app_wr_data[1] app_wr_data[2] app_wr_data[3] app_wr_data[4] app_wr_data[5] app_wr_data[6] app_wr_data[7] app_wr_en app_tx_req}]
set_false_path -to [get_ports {cfg_done app_rd_data[0] app_rd_data[1] app_rd_data[2] app_rd_data[3] app_rd_data[4] app_rd_data[5] app_rd_data[6] app_rd_data[7] app_rd_valid app_rd_frame_len[0] app_rd_frame_len[1] app_rd_frame_len[2] app_rd_frame_len[3] app_rd_frame_len[4] app_rd_frame_len[5] app_rd_frame_len[6] app_rd_frame_len[7] app_rd_frame_len[8] app_rd_frame_len[9] app_rd_frame_len[10] app_rd_frame_len[11] app_rd_frame_len[12] app_rd_frame_len[13] app_rd_frame_len[14] app_rd_frame_len[15] app_rd_frame_cnt[0] app_rd_frame_cnt[1] app_rd_frame_cnt[2] app_rd_frame_cnt[3] app_wr_gnt local_rtc[0] local_rtc[1] local_rtc[2] local_rtc[3] local_rtc[4] local_rtc[5] local_rtc[6] local_rtc[7] local_rtc[8] local_rtc[9] local_rtc[10] local_rtc[11] local_rtc[12] local_rtc[13] local_rtc[14] local_rtc[15] local_rtc[16] local_rtc[17] local_rtc[18] local_rtc[19] local_rtc[20] local_rtc[21] local_rtc[22] local_rtc[23] local_rtc[24] local_rtc[25] local_rtc[26] local_rtc[27] local_rtc[28] local_rtc[29] local_rtc[30] local_rtc[31] local_rtc[32] local_rtc[33] local_rtc[34] local_rtc[35] local_rtc[36] local_rtc[37] local_rtc[38] local_rtc[39] local_rtc[40] local_rtc[41] local_rtc[42] local_rtc[43] local_rtc[44] local_rtc[45] local_rtc[46] local_rtc[47] rtc_sync_valid irq_rx_frame irq_tx_done irq_error}]
